{
  "name": "agentmoataz",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first autonomous AI agent for Android (TypeScript agent core + Expo app + Kotlin native layer)",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "pnpm -r install",
    "lint": "eslint \"packages/**/src/**/*.ts\" \"apps/android/**/*.ts?(x)\" || echo 'eslint not configured yet'",
    "typecheck": "pnpm -r --filter \"@agentmoataz/*\" typecheck",
    "test": "vitest run",
    "build": "pnpm -r --filter './packages/*' build",
    "clean": "git clean -fdxq -e .env"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
